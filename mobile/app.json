{
  "expo": {
    "name": "N'ma Restaurant",
    "slug": "nma-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nma",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nma.restaurant"
    },
    "android": {
      "package": "com.nma.restaurant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "N'ma Restaurant",
      "shortName": "N'ma Restaurant",
      "lang": "fr",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#E63946",
      "backgroundColor": "#FAFAFA",
      "description": "Gérez votre restaurant depuis votre téléphone : ventes, caisse, stock, crédits et personnel."
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FAFAFA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "N'ma utilise vos photos pour illustrer les plats de votre menu.",
          "cameraPermission": "N'ma utilise l'appareil photo pour prendre en photo vos plats."
        }
      ]
    ],
    "description": "Gérez votre restaurant depuis votre téléphone : ventes, caisse, stock, crédits et personnel.",
    "primaryColor": "#E63946"
  }
}
