# =============================================================
# Variables utilisées par docker-compose.
# Copiez ce fichier en `.env` et adaptez les valeurs.
#   cp .env.example .env
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant_dev_password
POSTGRES_DB=restaurant
POSTGRES_PORT=5436

# --- API ---
API_PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Secret de signature des jetons : 32 caractères minimum en production.
# Générer une valeur solide :  openssl rand -base64 48
JWT_SECRET=changez-moi-par-une-valeur-aleatoire-de-48-caracteres-minimum
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Origines autorisées, séparées par des virgules. `*` en développement.
CORS_ORIGINS=*

# --- Compte Super Admin créé au premier `npm run seed` ---
SEED_SUPERADMIN_EMAIL=admin@exemple.com
SEED_SUPERADMIN_PASSWORD=motdepasse-super-admin-a-changer
SEED_SUPERADMIN_NAME=Super Admin
