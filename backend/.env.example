# =============================================================
# Développement du backend hors Docker (`npm run dev`).
# La base peut rester dans Docker : `docker compose up -d db`
# =============================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgres://restaurant:restaurant_dev_password@localhost:5436/restaurant
DATABASE_SSL=disable
DB_POOL_MAX=10

JWT_SECRET=dev-secret-a-remplacer-absolument-en-production-0123456789
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

CORS_ORIGINS=*
MAX_UPLOAD_BYTES=3145728
AUTO_MIGRATE=true

SEED_SUPERADMIN_EMAIL=admin@exemple.com
SEED_SUPERADMIN_PASSWORD=motdepasse-super-admin
SEED_SUPERADMIN_NAME=Super Admin
